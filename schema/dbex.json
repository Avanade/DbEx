{
  "title": "JSON Schema for DbEx code-generation (https://github.com/avanade/dbex).",
  "$schema": "https://json-schema.org/draft-04/schema#",
  "definitions": {
    "CodeGeneration": {
      "type": "object",
      "title": "Database-driven by-convention code-generation.",
      "properties": {
        "schema": {
          "type": "string",
          "title": "The default database schema name."
        },
        "domain": {
          "type": "string",
          "title": "The domain name.",
          "description": "Attempts to default from the underlying data project file path; uses the second to last segment of the child-most sub-directory by convention. For example, \u0060/xxx/yyy/My.App.Sales.Database\u0060, the domain would be \u0060Sales\u0060."
        },
        "efModel": {
          "type": "string",
          "title": "The default entity-framework code-generation choice.",
          "description": "Defaults to \u0060Yes\u0060 (indicates combination of \u0060ModelOnly\u0060 and \u0060ModelBuilderOnly\u0060).",
          "enum": [
            "Yes",
            "No",
            "ModelOnly",
            "ModelBuilderOnly"
          ]
        },
        "dotNetDataProjectPath": {
          "type": "string",
          "title": "The relative path for the .NET data-related project.",
          "description": "Attempts to default by convention to a sibling \u0060.Infrastructure\u0060 project based on the database directory name prefix; for example, \u0060../My.App.Infrastructure\u0060."
        },
        "dotNetDataEfRepositoriesPath": {
          "type": "string",
          "title": "The path to append to the \u0027{DotNetDataProjectPath}\u0027 for the .NET generated entity-framework repository code.",
          "description": "Defaults to \u0060Repositories\u0060."
        },
        "dotNetDataEfModelsPath": {
          "type": "string",
          "title": "The path to append to the \u0027{DotNetDataProjectPath}\u0027 for the .NET generated entity-framework models code.",
          "description": "Defaults to \u0060Persistence\u0060."
        },
        "columnNameIsDeleted": {
          "type": "string",
          "title": "The default \u0060IsDeleted\u0060 column name.",
          "description": "Defaults to \u0060IsDeleted\u0060."
        },
        "columnNameTenantId": {
          "type": "string",
          "title": "The default \u0060TenantId\u0060 column name.",
          "description": "Defaults to \u0060TenantId\u0060."
        },
        "columnNameRowVersion": {
          "type": "string",
          "title": "The default \u0060RowVersion\u0060 column name.",
          "description": "Defaults to \u0060RowVersion\u0060."
        },
        "columnNameCreatedBy": {
          "type": "string",
          "title": "The default \u0060CreatedBy\u0060 column name.",
          "description": "Defaults to \u0060CreatedBy\u0060."
        },
        "columnNameCreatedOn": {
          "type": "string",
          "title": "The default \u0060CreatedOn\u0060 column name.",
          "description": "Defaults to \u0060CreatedOn\u0060."
        },
        "columnNameUpdatedBy": {
          "type": "string",
          "title": "The default \u0060UpdatedBy\u0060 column name.",
          "description": "Defaults to \u0060UpdatedBy\u0060."
        },
        "columnNameUpdatedOn": {
          "type": "string",
          "title": "The default \u0060UpdatedOn\u0060 column name.",
          "description": "Defaults to \u0060UpdatedOn\u0060."
        },
        "outbox": {
          "type": "boolean",
          "title": "Indicates whether to generate the transactional-outbox database capabilities.",
          "description": "Defaults to \u0060false\u0060."
        },
        "outboxSchema": {
          "type": "string",
          "title": "The database schema name for the outbox tables and related objects.",
          "description": "Defaults to \u0060{schema}\u0060."
        },
        "outboxName": {
          "type": "string",
          "title": "The database table base name for the outbox tables and related objects.",
          "description": "Defaults to \u0060Outbox\u0060."
        },
        "tables": {
          "type": [
            "array",
            "null"
          ],
          "default": [],
          "title": "The database table collection configuration.",
          "items": {
            "$ref": "#/definitions/Table"
          }
        }
      }
    },
    "Table": {
      "type": "object",
      "title": "Database table configuration.",
      "properties": {
        "name": {
          "type": "string",
          "title": "The database table name."
        },
        "schema": {
          "type": "string",
          "title": "The database schema name (where applicable).",
          "description": "Defaults to the root \u0060{Schema}\u0060."
        },
        "includeColumns": {
          "type": [
            "array",
            "null"
          ],
          "default": [],
          "title": "The list of database columns to include specifically.",
          "description": "All columns are included by default; this provides a means to simply select those for inclusion.",
          "items": {
            "type": "string"
          }
        },
        "excludeColumns": {
          "type": [
            "array",
            "null"
          ],
          "default": [],
          "title": "The list of database columns to exclude specifically.",
          "description": "All columns are included by default; this provides a means to simply select those for exclusion. A single item of \u0027*\u0027 indicates all columns are to be excluded.",
          "items": {
            "type": "string"
          }
        },
        "efModel": {
          "type": "string",
          "title": "The entity-framework code-generation choice.",
          "description": "Defaults to root \u0060{EfModel}\u0060. A \u0060Yes\u0060 indicates combination of \u0060ModelOnly\u0060 and \u0060ModelBuilderOnly\u0060.",
          "enum": [
            "Yes",
            "No",
            "ModelOnly",
            "ModelBuilderOnly"
          ]
        },
        "efModelName": {
          "type": "string",
          "title": "The name of the entity-framework model associated with this instance.",
          "description": "Defaults to the database table\u0027s .NET formatted name."
        },
        "columnNameIsDeleted": {
          "type": "string",
          "title": "The default \u0060IsDeleted\u0060 column name.",
          "description": "Defaults to \u0060IsDeleted\u0060."
        },
        "columnNameTenantId": {
          "type": "string",
          "title": "The default \u0060TenantId\u0060 column name.",
          "description": "Defaults to \u0060TenantId\u0060."
        },
        "columnNameRowVersion": {
          "type": "string",
          "title": "The default \u0060RowVersion\u0060 column name.",
          "description": "Defaults to \u0060RowVersion\u0060."
        },
        "columnNameCreatedBy": {
          "type": "string",
          "title": "The default \u0060CreatedBy\u0060 column name.",
          "description": "Defaults to \u0060CreatedBy\u0060."
        },
        "columnNameCreatedOn": {
          "type": "string",
          "title": "The default \u0060CreatedOn\u0060 column name.",
          "description": "Defaults to \u0060CreatedOn\u0060."
        },
        "columnNameUpdatedBy": {
          "type": "string",
          "title": "The default \u0060UpdatedBy\u0060 column name.",
          "description": "Defaults to \u0060UpdatedBy\u0060."
        },
        "columnNameUpdatedOn": {
          "type": "string",
          "title": "The default \u0060UpdatedOn\u0060 column name.",
          "description": "Defaults to \u0060UpdatedOn\u0060."
        },
        "columns": {
          "type": [
            "array",
            "null"
          ],
          "default": [],
          "title": "The database column collection configuration.",
          "description": "This collection is optional. It is used to specifically declare and/or override the column configurations. This bypasses the {IncludeColumns} and {ExcludesColumns} lists.",
          "items": {
            "$ref": "#/definitions/Column"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "Column": {
      "type": "object",
      "title": "Database column configuration.",
      "properties": {
        "name": {
          "type": "string",
          "title": "The database column name."
        },
        "property": {
          "type": "string",
          "title": "The .NET property name equivalent for the column.",
          "description": "Defaults to the database column\u0027s .NET formatted name."
        },
        "type": {
          "type": "string",
          "title": "The corresponding .NET type equivalent for the column (including nullability).",
          "description": "Defaults to the database column\u0027s .NET type."
        },
        "valueConverter": {
          "type": "string",
          "title": "The .NET value converter source code for the column.",
          "description": "Defaults to \u0060null\u0060. This must be valid C# source code as it is applied as-is."
        },
        "default": {
          "type": "string",
          "title": "The .NET default value for the column\u0027s property.",
          "description": "Defaults to \u0060null\u0060. This must be valid C# source code as it is applied as-is."
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/CodeGeneration"
    }
  ]
}